{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Packet Payload Studio",
  "version": "2.0.0",
  "identifier": "io.github.raulx7i.packetpayloadstudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Packet Payload Studio",
        "width": 1360,
        "height": 840,
        "minWidth": 960,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/ppstudio-backend"
    ]
  }
}